#!/bin/bash
# Transfer Service Image Verifier Plugin for containerd
# This plugin is called by containerd's transfer service during image pull
# to verify image signatures before allowing the image to be used.
#
# CONFIGURATION: /etc/containerd/image-verifier.conf
#
# Format (one policy per line):
#   REGISTRY_POLICY_NAME=registry_pattern|trust_path[|identity]
#   trust_path is a root CA PEM (legacy signatures) or a Sigstore trusted
#   root .json (bundles). identity, for a trusted root, is the signing
#   certificate's SAN, matched exactly with an empty OIDC issuer, as a private
#   PKI certificate has none; without it any identity is accepted
#
# Example:
#   REGISTRY_POLICY_INTERNAL=registry.internal.corp:5000|/etc/containerd/certs/internal-ca.crt
#   REGISTRY_POLICY_PROD=registry-prod.example.com|/etc/containerd/certs/prod-ca.crt
#   REGISTRY_POLICY_LOCAL=127\.0\.0\.1:5000|/etc/containerd/certs/ca.crt
#   VERIFY_DEFAULT_ACTION=allow
#
# Default behavior (no matching policy): VERIFY_DEFAULT_ACTION
#   VERIFY_DEFAULT_ACTION=allow  - Allow images from unknown registries
#   VERIFY_DEFAULT_ACTION=deny   - Deny images from unknown registries
#
# VERIFY_REGISTRY_CONFIG: registry credentials oras reads to fetch bundles,
# default /etc/containerd/image-verifier-registries.json, may be absent
# VERIFY_PLAIN_HTTP: registry pattern oras reaches over plain http, default
# none
# VERIFY_MAX_BUNDLE_BYTES: largest bundle fetched, default 1 MiB

set -euo pipefail

# Load configuration from file
CONFIG_FILE="/etc/containerd/image-verifier.conf"
if [[ -f "${CONFIG_FILE}" ]]; then
    # Load env vars from config file using a safer method
    # Read line by line and export, avoiding bash interpretation of special chars
    while IFS= read -r line || [[ -n "${line}" ]]; do
        # Skip comments and empty lines
        [[ "${line}" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line}" ]] && continue
        # Export the KEY=VALUE line as is
        # shellcheck disable=SC2163
        export "${line}"
    done < "${CONFIG_FILE}"
fi

# Parse command line arguments
IMAGE_NAME=""
IMAGE_DIGEST=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -name)
            IMAGE_NAME="$2"
            shift 2
            ;;
        -digest)
            IMAGE_DIGEST="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

# Logging helper
log() {
    echo "$@" | logger -t containerd-verifier -p user.info
    echo "$@" >&2
}

# Verify we have required parameters
if [[ -z "${IMAGE_NAME}" ]] || [[ -z "${IMAGE_DIGEST}" ]]; then
    log "ERROR: Missing required parameters (-name or -digest)"
    log "  IMAGE_NAME='${IMAGE_NAME}'"
    log "  IMAGE_DIGEST='${IMAGE_DIGEST}'"
    exit 1
fi

log "===> VERIFIER CALLED: ${IMAGE_NAME}@${IMAGE_DIGEST}"

# Construct full image reference. For a pull by digest, as Kyverno's
# mutateDigest makes every pull, the name already ends in @digest; verify the
# digest containerd passes, once.
IMAGE_REF="${IMAGE_NAME%@*}@${IMAGE_DIGEST}"

# Default action for unknown registries (can be overridden via env var)
DEFAULT_ACTION="${VERIFY_DEFAULT_ACTION:-allow}"

# Find matching registry policy
MATCHED_POLICY=""
CA_CERT_PATH=""
IDENTITY=""

# Iterate through all environment variables starting with REGISTRY_POLICY_
for var in $(compgen -e | grep '^REGISTRY_POLICY_' || true); do
    policy_value="${!var}"

    # Parse policy: "registry_pattern|ca_cert_path" or "registry_pattern|ALLOW" or "registry_pattern|BLOCK"
    IFS='|' read -r registry_pattern ca_path identity <<< "${policy_value}"

    # Check if image name matches this registry pattern
    if [[ "${IMAGE_NAME}" =~ ^${registry_pattern} ]]; then
        log "Matched policy: ${var} (pattern: ${registry_pattern})"
        MATCHED_POLICY="${var}"
        CA_CERT_PATH="${ca_path}"
        IDENTITY="${identity}"
        break
    fi
done

# If no policy matched, use default action
if [[ -z "${MATCHED_POLICY}" ]]; then
    log "No registry policy matched for ${IMAGE_NAME}"

    if [[ "${DEFAULT_ACTION}" == "deny" ]]; then
        log "[FAIL] DEFAULT ACTION: DENY - Rejecting image from unknown registry"
        echo "Image rejected: no registry policy configured for ${IMAGE_NAME}"
        exit 1
    else
        log "[OK] DEFAULT ACTION: ALLOW - Allowing image from unknown registry"
        exit 0
    fi
fi

# A pinned identity is checked on bundles only; refuse it where it would be
# ignored rather than accept any signer
if [[ -n "${IDENTITY}" && "${CA_CERT_PATH}" != *.json ]]; then
    log "ERROR: ${MATCHED_POLICY} pins an identity, which only a trusted root .json policy checks"
    echo "Internal error: invalid policy ${MATCHED_POLICY}"
    exit 1
fi

# Handle special policy keywords: ALLOW and BLOCK
if [[ "${CA_CERT_PATH}" == "ALLOW" ]]; then
    log "[OK] POLICY ACTION: ALLOW - No verification required for ${IMAGE_NAME}"
    exit 0
elif [[ "${CA_CERT_PATH}" == "BLOCK" ]]; then
    log "[FAIL] POLICY ACTION: BLOCK - Registry blocked by policy: ${IMAGE_NAME}"
    echo "Image rejected: registry is blocked by policy"
    exit 1
fi

# Verify CA certificate exists
if [[ ! -f "${CA_CERT_PATH}" ]]; then
    log "ERROR: CA certificate not found: ${CA_CERT_PATH}"
    log "Policy: ${MATCHED_POLICY}"
    echo "Internal error: CA certificate missing"
    exit 1
fi

log "Verifying signature with: ${CA_CERT_PATH}"

# A .json trust file is a Sigstore trusted root: verify the image's bundles,
# its OCI referrers, the chain either in the bundle or in the root. cosign
# verify would fall back to legacy signatures when it finds no bundle, so each
# bundle is fetched and verified against the digest with cosign
# verify-blob-attestation, which has no legacy path. A root with timestamp
# authorities requires a signed timestamp and checks the leaf at its time, as
# Kyverno does, so a timestamped bundle outlives its leaf. A root whose
# authorities are root certificates alone takes the intermediate from the
# bundle; one that names intermediates allows those only, so a bundle carrying
# another intermediate under the same root, of a SubCA left out to revoke it,
# is refused, as in Kyverno.
if [[ "${CA_CERT_PATH}" == *.json ]]; then
    if ! tsa="$(jq '.timestampAuthorities // [] | length' "${CA_CERT_PATH}")" ||
        ! roots_only="$(jq 'all(.certificateAuthorities[]; (.certChain.certificates | length) == 1)' "${CA_CERT_PATH}")"; then
        log "ERROR: cannot read trusted root ${CA_CERT_PATH}"
        exit 1
    fi
    if [[ -n "${IDENTITY}" ]]; then
        IDENTITY_ARGS=(--certificate-identity "${IDENTITY}" --certificate-oidc-issuer-regexp '^$')
    else
        IDENTITY_ARGS=(--certificate-identity-regexp '.*' --certificate-oidc-issuer-regexp '.*')
    fi
    VERIFY_ARGS=(--trusted-root="${CA_CERT_PATH}" "${IDENTITY_ARGS[@]}"
        --insecure-ignore-tlog --insecure-ignore-sct
        --type https://sigstore.dev/cosign/sign/v1
        --digestAlg sha256 --digest "${IMAGE_DIGEST#sha256:}")
    if [[ "${tsa}" -gt 0 ]]; then
        VERIFY_ARGS+=(--use-signed-timestamps)
    fi
    if [[ "${roots_only}" == true ]]; then
        VERIFY_ARGS+=(--allow-certificate-chain)
    fi
    # containerd runs the verifier without HOME, where oras looks for registry
    # credentials, so name them
    ORAS_OPTS=(--registry-config "${VERIFY_REGISTRY_CONFIG:-/etc/containerd/image-verifier-registries.json}")
    if [[ -n "${VERIFY_PLAIN_HTTP:-}" && "${IMAGE_NAME}" =~ ^${VERIFY_PLAIN_HTTP} ]]; then
        ORAS_OPTS+=(--plain-http)
    fi
    # The repository without tag, as a tag and a digest do not combine in oras
    REPO="${IMAGE_NAME%@*}"
    [[ "${REPO##*/}" == *:* ]] && REPO="${REPO%:*}"
    # Digests only: they come from the registry, and name the fetches below
    if ! bundles="$(oras discover "${ORAS_OPTS[@]}" --format json \
        --artifact-type application/vnd.dev.sigstore.bundle.v0.3+json "${REPO}@${IMAGE_DIGEST}" |
        jq -r '.referrers[].digest | select(test("^sha256:[0-9a-f]{64}$"))')"; then
        log "[FAIL] Signature verification FAILED for ${IMAGE_REF}: cannot list its referrers"
        echo "Image signature verification failed for ${IMAGE_NAME}"
        exit 1
    fi
    if [[ -z "${bundles}" ]]; then
        log "[FAIL] Signature verification FAILED for ${IMAGE_REF}: no Sigstore bundle"
        echo "Image signature verification failed for ${IMAGE_NAME}"
        exit 1
    fi
    max_bytes="${VERIFY_MAX_BUNDLE_BYTES:-1048576}"
    bundle_file="$(mktemp --suffix=.json)"
    trap 'rm -f -- "${bundle_file}"' EXIT
    last=""
    readarray -t bundle_digests <<< "${bundles}"
    for bundle in "${bundle_digests[@]}"; do
        out="cannot fetch bundle ${bundle}"
        # A bundle is a few KiB; the registry's size claim and the bytes read
        # are both capped, so an unauthenticated blob cannot fill the disk
        if layer="$(oras manifest fetch "${ORAS_OPTS[@]}" "${REPO}@${bundle}" |
            jq -re --argjson max "${max_bytes}" \
                '.layers[0] | select(.size <= $max and (.digest | test("^sha256:[0-9a-f]{64}$"))) | .digest')" &&
            oras blob fetch "${ORAS_OPTS[@]}" --output - "${REPO}@${layer}" |
            head -c "$((max_bytes + 1))" > "${bundle_file}" &&
            [[ "$(stat -c %s "${bundle_file}")" -le "${max_bytes}" ]] &&
            out="$(cosign verify-blob-attestation "${VERIFY_ARGS[@]}" --bundle "${bundle_file}" 2>&1)"; then
            log "[OK] Signature verification PASSED for ${IMAGE_REF}"
            exit 0
        fi
        last="$(tail -n 1 <<< "${out}")"
    done
    log "[FAIL] Signature verification FAILED for ${IMAGE_REF}: ${last}"
    echo "Image signature verification failed for ${IMAGE_NAME}"
    exit 1
fi

# Anything else is a root CA PEM: verify legacy attached signatures.
if out="$(cosign verify \
    --new-bundle-format=false --ca-roots="${CA_CERT_PATH}" --private-infrastructure \
    --certificate-identity-regexp '.*' \
    --certificate-oidc-issuer-regexp '.*' \
    --insecure-ignore-sct=true \
    "${IMAGE_REF}" 2>&1)"; then
    log "[OK] Signature verification PASSED for ${IMAGE_REF}"
    exit 0
else
    log "[FAIL] Signature verification FAILED for ${IMAGE_REF}: $(tail -n 1 <<< "${out}")"
    echo "Image signature verification failed for ${IMAGE_NAME}"
    exit 1
fi
